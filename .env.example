# TrendCraft — Environment Variables
# Copy this to .env and fill in the values

# Database (Neon serverless Postgres)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/trendcraft?sslmode=require

# Session secret (for JWT/cookie signing)
SESSION_SECRET=your-secret-key-change-in-production

# Social Platform API Keys (to be added as integrations are built)
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# AI Provider (for content generation)
# OPENAI_API_KEY=sk-...

# AI Agent (the trend research + content generation pipeline)
# Provider mode — "mock" (default, no API key needed) or "openai"
AGENT_LLM=mock
AGENT_IMAGE=mock
# OpenAI overrides (used when AGENT_LLM=openai or AGENT_IMAGE=openai)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=org-...